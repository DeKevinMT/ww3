{
  "metadata": {
    "title": "Calorie-weighted food self-sufficiency ratios",
    "period": [2021, 2022, 2023],
    "unit": "ratio",
    "meaning": "1.0 means domestic food production is equivalent to domestic food availability; values above 1.0 indicate net export capacity.",
    "method": "For each year, non-overlapping FAOSTAT Food Balance Sheet food groups are converted to calorie equivalents using each group's Food supply (kcal/cap/day) and Food quantity. The ratio is production / (production + imports - exports). Values are the median of 2021-2023 when at least two years are available, rounded to three decimals.",
    "itemCodes": [2905, 2907, 2908, 2909, 2911, 2912, 2913, 2914, 2918, 2919, 2922, 2923, 2924, 2928, 2943, 2945, 2946, 2948, 2949, 2960, 2961],
